PORT=5000
NODE_ENV=development
# Database URL (For local SQLite: "file:./dev.db" | For Neon Postgres: "postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require")
DATABASE_URL="file:./dev.db"
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app
JWT_SECRET=super-secret-jwt-key-min-32-chars-long!
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-min-32!
LOG_LEVEL=info

