              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_UUID_HERE\",\n  \"lineItems\": [\n    {\n      \"productId\": \"PRODUCT_UUID_1\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"PRODUCT_UUID_2\",\n      \"quantity\": 5\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
