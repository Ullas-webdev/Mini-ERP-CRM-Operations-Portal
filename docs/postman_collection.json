                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "DRAFT" }
              ]
            }
          }
        },
        {
          "name": "Get Challan Detail Snapshot",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id"],
              "variable": [{ "key": "id", "value": "CHALLAN_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Export Challan PDF",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "pdf"],
              "variable": [{ "key": "id", "value": "CHALLAN_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Confirm & Fulfill Challan (SUCCESS)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "confirm"],
              "variable": [{ "key": "id", "value": "CHALLAN_UUID_HERE" }]
            }
          },
          "response": [
            {
              "name": "200 Success - Confirmed",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"ch-123\",\n    \"challanNumber\": \"CH-2026-0004\",\n    \"status\": \"CONFIRMED\",\n    \"confirmedAt\": \"2026-08-10T22:00:00.000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Confirm Challan (EDGE CASE: Insufficient Stock 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "confirm"],
              "variable": [{ "key": "id", "value": "CHALLAN_WITH_EXCESS_QTY_UUID" }]
            }
          },
          "response": [
            {
              "name": "400/422 Error - Insufficient Stock Edge Case",
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"INSUFFICIENT_STOCK\",\n    \"message\": \"Insufficient stock for line items. Transaction rolled back with zero deductions.\",\n    \"details\": [\n      {\n        \"productId\": \"9d406dfa-c017-42a0-a1ec-81742d30227a\",\n        \"productName\": \"Industrial Hydraulic Valve 3/4\\\"\",\n        \"sku\": \"SKU-VALVE-001\",\n        \"availableStock\": 2,\n        \"requestedQuantity\": 500,\n        \"shortage\": 498\n      }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Cancel Challan (Restores Stock if Confirmed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "cancel"],
              "variable": [{ "key": "id", "value": "CHALLAN_UUID_HERE" }]
            }
          }
        }
      ]
