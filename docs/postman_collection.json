{
  "info": {
    "_postman_id": "c886d27d-56e1-46cd-bc55-c5901eb85470",
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Comprehensive Postman collection for Mini ERP + CRM Monorepo API V1. Includes example request payloads, authentication tokens, and the 422 Insufficient Stock edge case response.",
